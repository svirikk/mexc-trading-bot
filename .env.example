# ============================================================================
# TELEGRAM (для сповіщень — вхід/вихід/помилки, більше НЕ для парсингу сигналів)
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# MEXC FUTURES API
# Створюється в особистому кабінеті MEXC -> API Management.
# Потрібна пройдена KYC та увімкнена саме permission "Futures Trading".
# НІКОЛИ не коміть цей файл з реальними ключами.
# ============================================================================
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://api.mexc.com

# ============================================================================
# РИЗИК / РОЗМІР ПОЗИЦІЇ
# ============================================================================
RISK_PERCENT_OF_DEPOSIT=1          # % депозиту, який втрачається якщо спрацює SL
LEVERAGE=20
TAKE_PROFIT_PERCENT=0.8            # % руху ЦІНИ від точки входу (не ROI)
STOP_LOSS_PERCENT=0.5              # % руху ЦІНИ від точки входу (не ROI)
OPEN_TYPE=1                        # 1 = isolated, 2 = cross
POSITION_MODE=1                    # 1 = hedge, 2 = one-way (див. налаштування акаунта MEXC)

# Невеликий буфер поверх SL/TP, щоб лімітний ордер на виході мав шанс
# реально виконатись (замість "зависання", якщо ціна проскочить точну ціну).
# 0 = рівно стільки, скільки прораховано (ризик "зависання" ордера вищий).
SL_FILL_BUFFER_PERCENT=0.03
TP_FILL_BUFFER_PERCENT=0.03

# ============================================================================
# ВИКОНАННЯ / ТАЙМІНГ
# ============================================================================
# Заходити рівно на початку наступної хвилини після сигналу
ENTRY_AT_NEXT_MINUTE=true
# Мс після 00 секунди наступної хвилини (щоб гарантовано пройти latency мережі)
ENTRY_BUFFER_MS=350

MAX_OPEN_POSITIONS=3
MAX_DAILY_TRADES=20

# true = нічого не відправляти на біржу, тільки логувати що було б зроблено
DRY_RUN=true
# Умовний баланс для розрахунків розміру позиції, поки DRY_RUN=true
DRY_RUN_BALANCE=1000

# ============================================================================
# РОБОЧІ ГОДИНИ (UTC). Поза цим вікном — "сон": нові сигнали не
# оцінюються, нові угоди не відкриваються, сповіщення не надсилаються.
# Позиції, відкриті ДО початку сну, продовжують моніторитись і закриватись
# як завжди (це навмисно — реальну відкриту позицію не можна "заморозити").
# ============================================================================
ENABLE_TRADING_HOURS=true
TRADING_HOURS_START_UTC=2
TRADING_HOURS_END_UTC=14

# ============================================================================
# МОНІТОРИНГ ПОЗИЦІЙ
# LIVE: основний шлях закриття позицій — приватний WS user-data стрім MEXC
# (push.personal.position, миттєво, без REST). LIVE_FALLBACK_POLL_MS — це
# лише РІДКІСНА страховка REST-запитом на випадок збою WS-стріму.
# DRY_RUN: реального акаунта немає, тому позиції "закриваються" симуляцією
# по тікеру раз на DRY_RUN_MONITOR_INTERVAL_MS.
# ============================================================================
DRY_RUN_MONITOR_INTERVAL_MS=20000
LIVE_FALLBACK_POLL_MS=60000

# ============================================================================
# ІНШЕ
# ============================================================================
WINDOW_SECONDS=180
STATS_LOG_INTERVAL=60
MAX_RECONNECTS=10
NODE_ENV=development
